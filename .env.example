# Copy to .env for local overrides. .env is gitignored — never commit secrets.

# Port the server listens on (Render sets this automatically).
PORT=3000

# Comma-separated list of origins allowed to connect (no "*", no trailing slash).
# Local default: http://localhost:3000,http://127.0.0.1:3000
# Production example: https://rdbagwell.github.io
ALLOWED_ORIGINS=

# Set to "production" on the real server (enforces https origins, HSTS).
NODE_ENV=development

# Real client IP for per-IP rate limits behind a proxy.
# CLIENT_IP_HEADER=true-client-ip
# TRUST_PROXY_HOPS=1

# Serve the client from this server too (handy locally). "false" on Render.
SERVE_CLIENT=true

# Optional limits
# MAX_GAMES=200
# MAX_CONNECTIONS_PER_IP=20

# AI players (Phase 4 plumbing). Off unless explicitly enabled.
ENABLE_LLM_PLAYERS=false
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# LLM_TOKEN_BUDGET_PER_GAME=60000
